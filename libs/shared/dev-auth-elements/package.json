  ],
  "files": [
    "**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "andersseen",
  "repository": {
    "type": "git",
    "url": "https://github.com/Andersseen/devflare.git",
    "directory": "libs/shared/dev-auth-elements"
  },
  "dependencies": {
    "@andersseen/web-components": "^0.5.0",
    "@andersseen/icon": "^0.1.1"
  }
}

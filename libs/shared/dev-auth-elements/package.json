{
  "name": "@dev-auth/elements",
  "version": "0.1.0",
  "description": "Framework-agnostic Custom Elements for the DevAuth SDK",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./tokens.css": "./styles/tokens.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [

{
  "name": "dev-auth-angular",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/dev-auth-angular/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["scope:shared", "type:core", "domain:dev-auth-sdk"],
  "implicitDependencies": ["dev-auth-client"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/libs/shared/dev-auth-angular"],
      "dependsOn": [
        {
          "projects": ["dev-auth-client"],
          "target": "build"
        }
      ],
      "options": {
        "project": "libs/shared/dev-auth-angular/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/shared/dev-auth-angular/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "dependsOn": ["build"],
      "options": {
        "packageRoot": "dist/libs/shared/dev-auth-angular"
      }
    }
  }
}

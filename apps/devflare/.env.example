# DevFlare authenticates through dev-auth, which is an OAuth 2.1 / OIDC provider.
# These are the credentials of DevFlare's registered client. The non-secret half
# also lives in wrangler.toml (Cloudflare passes vars as bindings, not env vars);
# these are the fallbacks used outside Cloudflare — vitest, plain node.

# Base URL of the provider
DEV_AUTH_URL=http://localhost:8787
# In production, point to your deployed auth service
# DEV_AUTH_URL=https://auth.yourdomain.com

# Client id, as registered in apps/dev-auth/wrangler.toml -> OAUTH_CLIENTS
DEV_AUTH_CLIENT_ID=devflare-dev

# Must match a registered redirect URI exactly
DEV_AUTH_REDIRECT_URI=http://localhost:4200/api/auth/callback

# Secret half of the client credentials. Must equal the value stored for this
# client id in the provider's OAUTH_CLIENT_SECRETS. Never commit it: put it in
# apps/devflare/.dev.vars locally, and use `wrangler secret put` for deployments.
# DEV_AUTH_CLIENT_SECRET=

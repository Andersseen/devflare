# Better Auth Configuration
BETTER_AUTH_SECRET=your-super-secret-key-here-change-in-production
BETTER_AUTH_URL=http://localhost:8787

# No COOKIE_DOMAIN: consumer apps complete the OAuth flow and keep their own
# session, so this service's cookie is never shared with them.

# CORS origins (comma-separated, production only)
# DEV_AUTH_CORS_ORIGINS=https://app.yourdomain.com

# Environment identifier
ENVIRONMENT=development

# Admin secret for protected endpoints
# ADMIN_SECRET=your-admin-secret

# GitHub OAuth (optional)
# GITHUB_CLIENT_ID=your-github-oauth-app-id
# GITHUB_CLIENT_SECRET=your-github-oauth-app-secret

# ---------------------------------------------------------------------------
# OAuth / OIDC provider — the applications allowed to authenticate here
# ---------------------------------------------------------------------------
# Client definitions are NOT secret and live in wrangler.toml as OAUTH_CLIENTS,
# so the redirect URIs the provider accepts stay visible in version control:
#
#   OAUTH_CLIENTS = '''[
#     { "clientId": "devflare-dev", "name": "DevFlare (local)", "type": "web",
#       "redirectURIs": ["http://localhost:4200/api/auth/callback"] }
#   ]'''
#
# Client secrets belong here (locally in apps/dev-auth/.dev.vars, in production
# via `wrangler secret put OAUTH_CLIENT_SECRETS`). One JSON object, keyed by
# client id. Generate a value with: openssl rand -hex 32
# OAUTH_CLIENT_SECRETS={"devflare-dev":"generate-a-long-random-string"}

# Sentry error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn

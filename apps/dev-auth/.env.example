# Placeholders only. Never commit real values.
#
# Copy to apps/dev-auth/.dev.vars for local development — that file is gitignored
# and must stay that way. Production values are set with `wrangler secret put`.

# Better Auth Configuration
#
# BETTER_AUTH_SECRET encrypts the private half of the token signing keys stored
# in the `jwks` table, so changing it invalidates them: rotate the secret and the
# table together, or the provider cannot sign a token it can still verify.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:8787

# No COOKIE_DOMAIN: consumer apps complete the OAuth flow and keep their own
# session, so this service's cookie is never shared with them.
#
# No APP_URL either. dev-auth is a standalone identity provider with no
# application of its own; a sign-in that did not come from an authorization
# request lands on this service's own page, not on any consumer app.

# CORS origins (comma-separated, production only)
# DEV_AUTH_CORS_ORIGINS=https://app.yourdomain.com

# Environment identifier
ENVIRONMENT=development

# Admin secret for protected endpoints
# ADMIN_SECRET=generate-a-long-random-string

# GitHub OAuth (optional). GitHub is an upstream identity provider for dev-auth
# alone — consumer applications never talk to GitHub themselves.
# GITHUB_CLIENT_ID=your-github-oauth-app-id
# GITHUB_CLIENT_SECRET=your-github-oauth-app-secret

# ---------------------------------------------------------------------------
# OAuth / OIDC provider — the applications allowed to authenticate here
# ---------------------------------------------------------------------------
# Client definitions are NOT secret and live in wrangler.toml as OAUTH_CLIENTS,
# so the redirect URIs the provider accepts stay visible in version control:
#
#   OAUTH_CLIENTS = '''[
#     { "clientId": "devflare-dev", "name": "DevFlare (local)", "type": "web",
#       "redirectURIs": ["http://localhost:4200/api/auth/callback"] }
#   ]'''
#
# Client secrets belong here (locally in apps/dev-auth/.dev.vars, in production
# via `wrangler secret put OAUTH_CLIENT_SECRETS`). One JSON object, keyed by
# client id. Only confidential (`type: "web"`) clients take one; a `native` or
# `user-agent-based` client is public and is rejected if given a secret.
# 32 characters or more — shorter ones are logged as a warning at boot.
# Generate a value with: openssl rand -base64 32
# OAUTH_CLIENT_SECRETS={"devflare-dev":"generate-a-long-random-string"}

# Sentry error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn

<and-card variant="elevated" padded
  and-layout="vertical gap:md"
  and-motion="fade-in slide-in-up"
  and-motion-trigger="enter"
  and-motion-duration="600ms">

  <div and-layout="horizontal justify:center align:center gap:sm">
    <and-icon name="lock" size="24"></and-icon>
    <span and-text="h6 weight:bold color:foreground">DevFlare Auth</span>
  </div>

  <div and-layout="vertical gap:xs">
    <h1 and-text="h4 align:center color:foreground">Welcome back</h1>
    <p and-text="p-sm align:center color:muted">Sign in to your account to continue</p>
  </div>

  <form id="login-form" and-layout="vertical gap:sm">
    <div and-layout="vertical gap:xs">
      <label for="email" and-text="p-xs color:foreground weight:medium">Email</label>
      <div and-layout="horizontal gap:sm align:center">
        <and-icon name="mail" size="16" color="hsl(var(--muted-foreground))"></and-icon>
        <and-input
          id="email"
          data-field="email"
          type="email"
          placeholder="you@example.com"
          required
          style="flex:1">
        </and-input>
      </div>
    </div>

    <div and-layout="vertical gap:xs">
      <label for="password" and-text="p-xs color:foreground weight:medium">Password</label>
      <div and-layout="horizontal gap:sm align:center">
        <and-icon name="lock" size="16" color="hsl(var(--muted-foreground))"></and-icon>
        <and-input
          id="password"
          data-field="password"
          type="password"
          placeholder="Enter your password"
          required
          style="flex:1">
        </and-input>
      </div>
    </div>

    <div and-layout="horizontal justify:end">
      <a id="forgot-link" href="/forgot" and-text="p-xs color:primary">Forgot password?</a>
    </div>

    <and-button
      id="submit-btn"
      type="submit"
      variant="default"
      data-full>
      <and-icon slot="start" name="arrow-right" size="16"></and-icon>
      Sign In
    </and-button>
  </form>

  <div and-layout="horizontal gap:sm align:center" style="margin:0.5rem 0">
    <div style="flex:1;height:1px;background:hsl(var(--border))"></div>
    <span and-text="p-xs color:muted">or</span>
    <div style="flex:1;height:1px;background:hsl(var(--border))"></div>
  </div>

  <div style="text-decoration:none">
    <and-button id="github-btn" variant="outline" data-full>
      <svg slot="start" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
      Continue with GitHub
    </and-button>
  </div>

  <p and-text="p-sm align:center color:muted">
    Don't have an account? <a id="signup-link" href="/signup">Sign up</a>
  </p>
</and-card>

<script>
  (function() {
    const form = document.getElementById('login-form');
    const submitBtn = document.getElementById('submit-btn');
    const toaster = document.getElementById('toaster');
    const githubBtn = document.getElementById('github-btn');

    // Where a sign-in that did NOT come from an authorization request lands.
    // '/' is this provider's own signed-in page — it used to be a consumer app's
    // URL, which quietly made "sign in to DevAuth" mean "sign in to DevFlare".
    // DevAuth serves several applications, so it cannot pick one of them.
    //
    // An OAuth authorization request overrides this entirely: see resumeUrl().
    function destination() {
      const params = new URLSearchParams(window.location.search);
      return params.get('callback') || '/';
    }

    // An application that sent the user here to authorize arrives with the
    // authorization request in this page's query string, signed by the provider.
    // Handing that string back verbatim on sign-in is what lets the provider
    // verify it and resume the flow; re-assembling it from parts would break the
    // signature. Null when the user just opened /login themselves.
    function oauthQuery() {
      const search = window.location.search.replace(/^\?/, '');
      return new URLSearchParams(search).get('sig') ? search : null;
    }

    // Once the provider has resumed the request it answers with the URL to
    // continue at — the consumer's redirect_uri carrying the authorization code.
    // Following it is what closes the OAuth loop.
    function resumeUrl(data) {
      return (data && data.url) || null;
    }

    // Carry the authorization request across to the sibling pages, or the user
    // signs up / resets a password and the flow they came for is lost.
    (function keepAuthorizeParams() {
      const search = window.location.search;
      if (!new URLSearchParams(search).get('client_id')) return;
      ['signup-link', 'forgot-link'].forEach(function(id) {
        const link = document.getElementById(id);
        if (link) link.href = link.getAttribute('href') + search;
      });
    })();

    // A failed OAuth callback redirects back here carrying ?error=. Without
    // this the page looked untouched and the failure was indistinguishable
    // from the button doing nothing at all.
    (function showCallbackError() {
      const reason = new URLSearchParams(window.location.search).get('error');
      if (!reason) return;

      const messages = {
        account_not_linked:
          'That address already has a password account. Sign in with your password, then link GitHub from your profile.',
        access_denied: 'GitHub sign-in was cancelled.',
      };

      toaster.present(messages[reason] || ('Sign-in failed: ' + reason), 'error');
      // Drop the param so a refresh does not replay the toast.
      const url = new URL(window.location.href);
      url.searchParams.delete('error');
      url.searchParams.delete('error_description');
      window.history.replaceState({}, '', url);
    })();

    // Read straight off the element instead of accumulating change events:
    // `and-input` exposes its current text as a reflected `value` prop, so
    // this also picks up values the component was rendered with. (The old
    // code listened for `andInput`, which the component never emits — its
    // event is `andInputChange` — so every field always read as empty.)
    function field(name) {
      const input = form.querySelector('and-input[data-field="' + name + '"]');
      return input ? input.value || '' : '';
    }

    form.addEventListener('submit', async function(e) {
      e.preventDefault();

      const email = field('email').trim();
      const password = field('password');

      if (!email || !password) {
        toaster.present('Please fill in all fields', 'error');
        return;
      }

      submitBtn.loading = true;

      try {
        const body = { email: email, password: password };
        const pending = oauthQuery();
        if (pending) body.oauth_query = pending;

        const res = await fetch('/api/auth/sign-in/email', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(body)
        });

        const data = await res.json();

        if (!res.ok) {
          throw new Error(data.message || data.error || 'Invalid credentials');
        }

        toaster.present('Signed in successfully', 'success');
        const callback = resumeUrl(data) || destination();
        setTimeout(function() { window.location.href = callback; }, 600);
      } catch (err) {
        submitBtn.loading = false;
        toaster.present(err.message || 'Something went wrong. Please try again.', 'error');
      }
    });

    // `/api/auth/sign-in/social` is POST-only. This used to be a plain <a href>,
    // so the browser issued a GET and better-auth answered 404 — which read as
    // "GitHub login is broken" when in fact the endpoint was never reached.
    // The POST returns the provider's authorize URL for us to navigate to.
    githubBtn.addEventListener('click', async function() {
      githubBtn.loading = true;

      try {
        // The authorization request travels through GitHub and back: the
        // provider stores it against the social sign-in so that the callback
        // returns the browser to the consumer app rather than to this page.
        // This is what keeps GitHub an upstream detail of DevAuth — the consumer
        // never talks to GitHub itself.
        const body = { provider: 'github', callbackURL: destination() };
        const pending = oauthQuery();
        if (pending) body.oauth_query = pending;

        const res = await fetch('/api/auth/sign-in/social', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(body)
        });

        const data = await res.json();

        if (!res.ok || !data.url) {
          throw new Error(data.message || data.error || 'Could not start GitHub sign-in');
        }

        window.location.href = data.url;
      } catch (err) {
        githubBtn.loading = false;
        toaster.present(err.message || 'Could not start GitHub sign-in', 'error');
      }
    });
  })();
</script>

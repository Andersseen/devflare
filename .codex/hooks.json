{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh '/Users/andriipap/Andersseen/Web/Projects/devflare/.codex/hooks/block-protected-edits.sh'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh '/Users/andriipap/Andersseen/Web/Projects/devflare/.codex/hooks/format-file.sh'"
          },
          {
            "type": "command",
            "command": "sh '/Users/andriipap/Andersseen/Web/Projects/devflare/.codex/hooks/compile-flow.sh'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh '/Users/andriipap/Andersseen/Web/Projects/devflare/.codex/hooks/session-state.sh'"
          }
        ]
      }
    ]
  }
}

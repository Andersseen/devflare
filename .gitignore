# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
# Unanchored: vitest writes per-project reports to apps/*/coverage too, which a
# leading-slash pattern would miss.
coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

.angular
.playwright-mcp

vite.config.*.timestamp*
vitest.config.*.timestamp*

# Wrangler local state: miniflare D1/KV for dev, and the generated
# .wrangler/deploy/config.json that points at the built worker config.
.wrangler/

# Local secrets. AGENTS.md promised these were ignored; only
# apps/dev-auth/.gitignore actually did it, and by then apps/dev-auth/.dev.vars
# had already been committed — .gitignore does not apply to tracked files, so
# that one needs `git rm --cached` (and its BETTER_AUTH_SECRET rotating).
.env
.dev.vars

__screenshots__/

# Legacy local SQLite DB — replaced by Cloudflare D1 (miniflare state lives in .wrangler/)
data/

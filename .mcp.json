{
  "mcpServers": {
    "angular": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@angular/cli", "mcp"]
    },
    "nx-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["nx", "mcp"]
    },
    "volt-ui": {
      "type": "url",
      "url": "https://volt-ui.pages.dev/api/mcp"
    },
    "ngp-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@ng-primitives/mcp"]
    },
    "sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp"
    },
    "cloudflare-observability": {
      "type": "sse",
      "url": "https://observability.mcp.cloudflare.com/sse"
    }
  }
}
